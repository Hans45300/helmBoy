{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "$comment": [
    "Visual Studio generator selection must happen at configure time.",
    "Do not reuse the legacy build/ tree if it was configured with NMake."
  ],
  "configurePresets": [
    {
      "name": "vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "v145,host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_VST3": true,
        "BUILD_AU": false,
        "BUILD_LV2": false,
        "BUILD_AAX": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "description": "Main Windows IDE build using the Visual Studio 18 2026 generator.",
      "inherits": "vs2026-base"
    },
    {
      "name": "vs2026-x64-all-formats",
      "displayName": "Visual Studio 2026 x64 All Formats",
      "description": "Windows IDE build with VST3 and LV2 enabled.",
      "inherits": "vs2026-base",
      "cacheVariables": {
        "BUILD_VST3": true,
        "BUILD_AU": false,
        "BUILD_LV2": true,
        "BUILD_AAX": false
      }
    },
    {
      "name": "ninja-msvc-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_VST3": true,
        "BUILD_AU": false,
        "BUILD_LV2": false,
        "BUILD_AAX": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/18/Professional/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe",
        "CMAKE_MT": "C:/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64/mt.exe",
        "CMAKE_RC_COMPILER": "C:/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64/rc.exe",
        "CMAKE_C_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Professional/VC/Tools/MSVC/14.50.35717/bin/Hostx64/x64/cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Professional/VC/Tools/MSVC/14.50.35717/bin/Hostx64/x64/cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ninja-msvc-x64",
      "displayName": "Ninja MSVC x64",
      "description": "Windows build using Ninja Multi-Config with MSVC. Run from a Developer shell or after vcvars64.bat.",
      "inherits": "ninja-msvc-base"
    },
    {
      "name": "ninja-msvc-x64-all-formats",
      "displayName": "Ninja MSVC x64 All Formats",
      "description": "Windows Ninja build with VST3 and LV2 enabled. Run from a Developer shell or after vcvars64.bat.",
      "inherits": "ninja-msvc-base",
      "cacheVariables": {
        "BUILD_VST3": true,
        "BUILD_AU": false,
        "BUILD_LV2": true,
        "BUILD_AAX": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-x64-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-x64-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "vs2026-x64-all-formats-release",
      "configurePreset": "vs2026-x64-all-formats",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-x64-debug",
      "configurePreset": "ninja-msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "ninja-msvc-x64-release",
      "configurePreset": "ninja-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "ninja-msvc-x64-all-formats-release",
      "configurePreset": "ninja-msvc-x64-all-formats",
      "configuration": "Release"
    }
  ]
}